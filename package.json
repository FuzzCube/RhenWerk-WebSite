{
  "name": "rheinwerk-industrieservice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import ./tests/unit/ts-resolve.mjs --test \"tests/unit/*.test.mjs\"",
    "supabase:check": "node --env-file=.env.local scripts/check-supabase.mjs",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.tmp && (echo '// Generated by `npm run db:types` (supabase gen types typescript --local). Do not edit manually.'; cat lib/supabase/database.types.tmp) > lib/supabase/database.types.ts && rm lib/supabase/database.types.tmp",
    "test:db": "supabase test db",
    "test:api": "node --env-file=.env.local scripts/test-api.mjs",
    "test:auth": "node --env-file=.env.local scripts/test-auth.mjs",
    "test:ui": "node --env-file=.env.local scripts/test-ui.mjs",
    "test:agent": "node --env-file=.env.local scripts/test-agent.mjs",
    "agent:sync": "node --env-file=.env.local scripts/elevenlabs-agent.mjs",
    "agent:latency": "node --env-file=.env.local scripts/agent-latency.mjs",
    "agent:simulate": "node --env-file=.env.local scripts/agent-simulate.mjs",
    "demo:users": "node --env-file=.env.local scripts/bootstrap-demo-users.mjs",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "demo:verify": "docker exec -i supabase_db_A.Sadkovojs_Project psql -U postgres -qAt < scripts/demo/verify-seed.sql",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "backup:check": "node --env-file=.env.local scripts/backup-check.mjs",
    "ops:install": "node scripts/ops/install.mjs",
    "nightly": "node --env-file=.env.local scripts/ops/nightly.mjs",
    "watchdog": "node --env-file=.env.local scripts/ops/watchdog.mjs",
    "notify:test": "node --env-file=.env.local scripts/notify-test.mjs",
    "customers:backfill": "node --env-file-if-exists=.env.local scripts/customers-backfill.mjs",
    "test:calls": "node --env-file=.env.local scripts/test-calls.mjs",
    "workshop:status": "node scripts/workshop-status.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "1.26.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/blob": "2.8.0",
    "lucide-react": "1.40.0",
    "next": "16.3.8",
    "nodemailer": "10.0.14",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
