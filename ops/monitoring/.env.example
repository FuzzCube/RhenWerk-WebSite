# Only on the VPS in /opt/monitoring/.env (mode 600).
BESZEL_KEY=
BESZEL_TOKEN=
# Dedicated Cloudflare tunnel, optional until public access is configured.
MONITORING_TUNNEL_TOKEN=
# Written by bootstrap.mjs from access.json (Beszel superuser for the Homepage widget).
HOMEPAGE_VAR_BESZEL_EMAIL=
HOMEPAGE_VAR_BESZEL_PASSWORD=
