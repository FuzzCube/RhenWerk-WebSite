<?xml version="1.0" encoding="UTF-8"?>
<!-- Requests from the dashboard (task-17-6), every minute. Template: npm run prod:install fills in __PROD_DIR__.
     Without a waiting request the script ends at once. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>online.rheinwerk.requests</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd __PROD_DIR__/current &amp;&amp; exec node --env-file=__PROD_DIR__/shared/.env.local scripts/prod/requests.mjs</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__PROD_DIR__/logs/requests.log</string>
  <key>StandardErrorPath</key><string>__PROD_DIR__/logs/requests.log</string>
</dict></plist>
