<?xml version="1.0" encoding="UTF-8"?>
<!-- Nightly update with daily backup (task-17-5), 02:00. Template: npm run prod:install fills in __PROD_DIR__.
     The script of the active release runs with the shared environment; macOS catches up a run missed while asleep. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>online.rheinwerk.update</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd __PROD_DIR__/current &amp;&amp; exec node --env-file=__PROD_DIR__/shared/.env.local scripts/prod/update.mjs --nightly</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__PROD_DIR__/logs/update.log</string>
  <key>StandardErrorPath</key><string>__PROD_DIR__/logs/update.log</string>
</dict></plist>
