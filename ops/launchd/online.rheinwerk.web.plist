<?xml version="1.0" encoding="UTF-8"?>
<!-- Production app service (task-17-1). Template: npm run prod:install fills in __PROD_DIR__ and __PORT__ and loads it.
     zsh -lc loads the user profile so that node is on the path; cd resolves the symlink current on every start. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>online.rheinwerk.web</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd __PROD_DIR__/current &amp;&amp; exec node_modules/.bin/next start -p __PORT__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__PROD_DIR__/logs/web.log</string>
  <key>StandardErrorPath</key><string>__PROD_DIR__/logs/web.log</string>
</dict></plist>
