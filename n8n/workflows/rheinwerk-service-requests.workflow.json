        "jsCode": "const p=$('Formular prüfen').first().json.payload;const files=p.contract_and_attachments.attachments;\nconst normalized=files.map((a,i)=>{const url=a.download_url??a.url;if(typeof url!=='string'||!url)throw new Error('Нет приватной ссылки на вложение');if(!/^https:\\/\\/[a-z0-9]+\\.private\\.blob\\.vercel-storage\\.com\\/(?!\\/)[^\\s\\\\]*$/i.test(url))throw new Error('Недопустимый источник вложения');const fname=a.file_name.replace(/[^a-zA-Z0-9._-]/g,'_').slice(0,100);return {...a,storage_path:'requests/'+p.submission_id.toLowerCase()+'/'+i+'_'+fname};});\nconst payload={...p,contract_and_attachments:{...p.contract_and_attachments,attachments:normalized}};\nreturn normalized.length?normalized.map(a=>({json:{payload,attachment:a,storage_path:a.storage_path,skip_file:false}})):[{json:{payload,skip_file:true}}];"
