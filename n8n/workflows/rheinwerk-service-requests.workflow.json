    {
      "id": "0e6127db-bcc3-4b7e-b57d-383631f33dfb",
      "name": "Formular prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json; const p=x.body??x; const invalid=[];\nconst fields=['contact.company_name','contact.contact_name','contact.business_email','contact.phone','site_and_equipment.street_and_number','site_and_equipment.postal_code','site_and_equipment.city','site_and_equipment.equipment_type','request.service_type','request.description','request.urgency','request.known_safety_hazard','request.preferred_service_date'];\nfor(const f of fields){const v=f.split('.').reduce((o,k)=>o?.[k],p);if(typeof v!=='string'||!v.trim())invalid.push(f);}\nif(p.schema_version!=='1.0'||(p.contract_version&&p.contract_version!=='1.0'))invalid.push('schema_version');\nif(!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(p.submission_id??''))invalid.push('submission_id');\nif(p.privacy_consent!==true)invalid.push('privacy_consent');\nif(!/^[^@\\s]+@[^@\\s.]+\\.[a-z]{2,}$/i.test(p.contact?.business_email??''))invalid.push('contact.business_email');\nif(!/^[+0][\\d\\s()/-]{6,}$/.test(p.contact?.phone??''))invalid.push('contact.phone');\nif(!/^\\d{5}$/.test(p.site_and_equipment?.postal_code??''))invalid.push('site_and_equipment.postal_code');\nif((p.request?.description??'').trim().length<10)invalid.push('request.description');\nif(!['pump','compressor','ventilation','other'].includes(p.site_and_equipment?.equipment_type))invalid.push('site_and_equipment.equipment_type');\nif(!['inspection','maintenance','repair'].includes(p.request?.service_type))invalid.push('request.service_type');\nif(!['planned','time_sensitive','significant','production_stop'].includes(p.request?.urgency))invalid.push('request.urgency');\nif(!['no','yes','unclear'].includes(p.request?.known_safety_hazard))invalid.push('request.known_safety_hazard');\nif(!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.request?.preferred_service_date??''))invalid.push('request.preferred_service_date');\nconst a=p.contract_and_attachments?.attachments;\nif(!Array.isArray(a)||a.length>3)invalid.push('contract_and_attachments.attachments');\nelse for(const f of a){if(!f.pathname?.startsWith('service-requests/'+p.submission_id+'/')||!['application/pdf','image/jpeg','image/png'].includes(f.mime_type)||!Number.isInteger(f.size_bytes)||f.size_bytes<1||f.size_bytes>5242880||f.upload_status!=='uploaded'||!f.file_name)invalid.push('contract_and_attachments.attachments');}\nconst {turnstile_token,...clean}=p;return [{json:{payload:{...clean,contract_version:'1.0'},valid:invalid.length===0,invalid_fields:[...new Set(invalid)]}}];"
      }
    },
