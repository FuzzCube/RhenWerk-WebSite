[
  {
    "key": "schedule",
    "kind": "trigger",
    "type": "n8n-nodes-base.scheduleTrigger",
    "version": 1.4,
    "config": {
      "name": "Freigegebene E-Mails jede Minute",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "profile",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Versandpostfach prüfen",
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rw46346a76655347",
          "name": "RheinWerk Gmail"
        }
      }
    },
    "output": [
      {
        "json": {
          "body": {
            "emailAddress": "rheinwerk.industrieservice@gmail.com"
          }
        }
      }
    ]
  },
  {
    "key": "mailbox",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Versandpostfach bestätigen",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const mailbox=String(r.body?.emailAddress??r.emailAddress??'').toLowerCase();if(mailbox!=='rheinwerk.industrieservice@gmail.com')throw new Error('RheinWerk Gmail-Konto nicht bestätigt');return [{json:{mailbox_verified:true}}];"
      }
    },
    "output": [
      {
        "json": {
          "mailbox_verified": true
        }
      }
    ]
  },
  {
    "key": "claim",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Freigegebene Nachrichten reservieren",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:54321/rest/v1/rpc/claim_queued_messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "@@{{ {batch_limit:5,lease_seconds:600} }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rwdda8aefff1e947",
          "name": "RheinWerk Supabase Lokal"
        }
      }
    },
    "output": [
      {
        "json": {
          "id": "00000000-0000-4000-8000-000000000001",
          "direction": "outgoing",
          "status": "queued",
          "approved_by": "dispatcher",
          "approved_at": "2026-10-08T12:00:00Z"
        }
      }
    ]
  },
  {
    "key": "loop",
    "kind": "splitInBatches",
    "type": "n8n-nodes-base.splitInBatches",
    "version": 3,
    "config": {
      "name": "Nachrichten einzeln versenden",
      "parameters": {
        "batchSize": 1
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "mime",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "MIME mit stabiler Nachrichten-ID",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const m=$input.first().json;const mailbox='rheinwerk.industrieservice@gmail.com';\nif(m.direction!=='outgoing'||m.status!=='queued'||!m.approved_by||!m.approved_at)throw new Error('Freigegebene Nachricht erforderlich');\nif(!/^[0-9a-f-]{36}$/i.test(m.id)||!/^[^\\s<>@]+@[^\\s<>@]+\\.[^\\s<>@]+$/.test(m.to_address??''))throw new Error('Ungültige Nachrichtenidentität oder Empfängeradresse');\nconst clean=s=>String(s??'').replace(/[\\r\\n]/g,' ').trim();const messageId='<'+m.id+'@rheinwerk-service.online>';\nconst subj=clean(m.subject);const chunks=Array.from(subj.matchAll(/.{1,30}/gu),x=>'=?UTF-8?B?'+Buffer.from(x[0]).toString('base64')+'?=');\nconst headers=['From: RheinWerk Industrieservice <'+mailbox+'>','To: '+m.to_address,'Subject: '+chunks.join('\\r\\n '),'Message-ID: '+messageId,'X-RheinWerk-Message-Id: '+m.id,'Date: '+new Date().toUTCString(),'MIME-Version: 1.0','Content-Type: text/plain; charset=UTF-8','Content-Transfer-Encoding: base64'];\nconst refs=[...(Array.isArray(m.references_header)?m.references_header:[]),m.in_reply_to].filter(x=>typeof x==='string'&&/^<[^<>\\s]+>$/.test(x));\nif(m.in_reply_to&&/^<[^<>\\s]+>$/.test(m.in_reply_to))headers.push('In-Reply-To: '+m.in_reply_to);\nif(refs.length)headers.push('References: '+[...new Set(refs)].slice(-20).join(' '));\nconst body=Buffer.from(String(m.body_text??''),'utf8').toString('base64').match(/.{1,76}/g)?.join('\\r\\n')??'';\nconst raw=Buffer.from(headers.join('\\r\\n')+'\\r\\n\\r\\n'+body).toString('base64url');\nreturn [{json:{message_id:m.id,mime_message_id:messageId,recipient:m.to_address,search_query:'in:sent to:'+m.to_address,send_body:{raw,...(m.gmail_thread_id?{threadId:m.gmail_thread_id}:{})}}}];"
      }
    },
    "output": [
      {
        "json": {
          "message_id": "example",
          "mime_message_id": "<example@rheinwerk-service.online>",
          "recipient": "customer@example.com",
          "search_query": "in:sent to:customer@example.com",
          "send_body": {
            "raw": "example"
          }
        }
      }
    ]
  },
  {
    "key": "search",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Bereits gesendete Nachricht suchen",
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": false
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "@@{{ $json.search_query }}"
            },
            {
              "name": "maxResults",
              "value": "100"
            }
          ]
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rw46346a76655347",
          "name": "RheinWerk Gmail"
        }
      }
    },
    "output": [
      {
        "json": {
          "body": {
            "messages": []
          }
        }
      }
    ]
  },
  {
    "key": "candidates",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Versandkandidaten vorbereiten",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body??{};\nif(b.nextPageToken)throw new Error('Mehr als 100 gesendete Kandidaten: manuelle Versandprüfung erforderlich, kein erneuter Versand');\nconst messages=b.messages??[];return messages.length?messages.map(m=>({json:{candidate_id:m.id},pairedItem:{item:0}})):[{json:{skip_candidate:true},pairedItem:{item:0}}];"
      }
    },
    "output": [
      {
        "json": {
          "candidate_id": "gmail-example",
          "skip_candidate": false
        }
      }
    ]
  },
  {
    "key": "hascandidate",
    "kind": "ifElse",
    "type": "n8n-nodes-base.if",
    "version": 2.3,
    "config": {
      "name": "Versandkandidat vorhanden?",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "@@{{ $json.skip_candidate !== true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "candidate",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Versandkandidat laden",
      "parameters": {
        "method": "GET",
        "url": "@@{{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/'+encodeURIComponent($json.candidate_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": false
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "metadata"
            }
          ]
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rw46346a76655347",
          "name": "RheinWerk Gmail"
        }
      }
    },
    "output": [
      {
        "json": {
          "statusCode": 200,
          "body": {
            "id": "gmail-example",
            "payload": {
              "headers": []
            }
          }
        }
      }
    ]
  },
  {
    "key": "matchsent",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Interne Versand-ID abgleichen",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta=$('MIME mit stabiler Nachrichten-ID').item.json;const matches=[];\nfor(const item of $input.all()){if(item.json.skip_candidate)continue;const b=item.json.body;\nif(item.json.statusCode!==200||!b?.id||!Array.isArray(b.payload?.headers))throw new Error('Gmail-Versandprüfung unvollständig: kein erneuter Versand');\nconst header=name=>b.payload.headers.find(h=>String(h.name).toLowerCase()===name)?.value??'';\nconst recipient=header('to').toLowerCase().includes(meta.recipient.toLowerCase());\nconst identity=header('x-rheinwerk-message-id')===meta.message_id||[meta.mime_message_id,'<'+meta.message_id+'@rheinwerk-dashboard>'].includes(header('message-id'));\nif(recipient&&identity)matches.push({id:b.id,threadId:b.threadId});}\nif(matches.length>1)throw new Error('Mehrere Gmail-Versände mit derselben internen ID: manuelle Prüfung erforderlich');\nreturn [{json:{body:{messages:matches}},pairedItem:{item:0}}];"
      }
    },
    "output": [
      {
        "json": {
          "body": {
            "messages": []
          }
        }
      }
    ]
  },
  {
    "key": "exists",
    "kind": "ifElse",
    "type": "n8n-nodes-base.if",
    "version": 2.3,
    "config": {
      "name": "Versand bereits nachgewiesen?",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "@@{{ ($json.body.messages ?? []).length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "found",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Bestehenden Versand nachlesen",
      "parameters": {
        "method": "GET",
        "url": "@@{{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/'+encodeURIComponent($json.body.messages?.[0]?.id ?? $json.body.id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "metadata"
            }
          ]
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rw46346a76655347",
          "name": "RheinWerk Gmail"
        }
      },
      "onError": "continueRegularOutput"
    },
    "output": [
      {
        "json": {
          "statusCode": 200,
          "body": {
            "id": "gmail-example",
            "threadId": "thread-example"
          }
        }
      }
    ]
  },
  {
    "key": "send",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Freigegebene E-Mail senden",
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "@@{{ $('MIME mit stabiler Nachrichten-ID').item.json.send_body }}"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rw46346a76655347",
          "name": "RheinWerk Gmail"
        }
      },
      "onError": "continueRegularOutput"
    },
    "output": [
      {
        "json": {
          "statusCode": 200,
          "body": {
            "id": "gmail-example",
            "threadId": "thread-example"
          }
        }
      }
    ]
  },
  {
    "key": "accepted",
    "kind": "ifElse",
    "type": "n8n-nodes-base.if",
    "version": 2.3,
    "config": {
      "name": "Gmail-Versand angenommen?",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "@@{{ $json.statusCode >= 200 && $json.statusCode < 300 && typeof $json.body?.id === \"string\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "delivery",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Gmail-Ergebnis auswerten",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const meta=$('MIME mit stabiler Nachrichten-ID').item.json;const b=r.body??r;\nconst ok=r.statusCode>=200&&r.statusCode<300&&typeof b.id==='string'&&typeof b.threadId==='string';\nconst actualMime=b.payload?.headers?.find(h=>String(h.name).toLowerCase()==='message-id')?.value;\nreturn [{json:{...meta,ok,confirmation:{message_id:meta.message_id,mailbox_key:'rheinwerk.industrieservice@gmail.com',gmail_message_id:b.id??null,gmail_thread_id:b.threadId??null,mime_message_id:actualMime??meta.mime_message_id,sent_at:new Date().toISOString()},failure:{message_id:meta.message_id,permanent:r.statusCode===400,error_text:String(b.error?.message??r.error?.message??'Gmail delivery outcome unknown').slice(0,1000)}}}];"
      }
    },
    "output": [
      {
        "json": {
          "ok": true,
          "confirmation": {
            "message_id": "example"
          },
          "failure": {
            "message_id": "example"
          }
        }
      }
    ]
  },
  {
    "key": "ok",
    "kind": "ifElse",
    "type": "n8n-nodes-base.if",
    "version": 2.3,
    "config": {
      "name": "Versand bestätigt?",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "@@{{ $json.ok === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "confirm",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Bestätigten Versand speichern",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:54321/rest/v1/rpc/confirm_message_sent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "@@{{ $json.confirmation }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rwdda8aefff1e947",
          "name": "RheinWerk Supabase Lokal"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "failure",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
    "config": {
      "name": "Versandfehler für Wiederholung speichern",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:54321/rest/v1/rpc/mark_message_failed",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "@@{{ $json.failure }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rwdda8aefff1e947",
          "name": "RheinWerk Supabase Lokal"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  }
]