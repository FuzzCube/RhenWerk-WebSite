      "id": "88a7e8bd-9594-43db-8b88-cd7e5d47fad9",
      "name": "Freigegebene Nachrichten reservieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        780,
        0
      ],
