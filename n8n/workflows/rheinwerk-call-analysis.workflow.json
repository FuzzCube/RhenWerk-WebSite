      "id": "4b9390a0-82d6-5902-af4e-ae53729de7b8",
      "name": "Gespräch laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "rwElevenLabs0001",
          "name": "RheinWerk ElevenLabs"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c=$json;const m=c.metadata??{};\nconst lines=[];\nfor(const t of c.transcript??[]){\n  for(const call of t.tool_calls??[]) if(call.tool_name) lines.push(`[Werkzeug ${call.tool_name}: ${String(call.params_as_json??'').slice(0,300)}]`);\n  for(const r of t.tool_results??[]) if(r.tool_name) lines.push(`[Ergebnis ${r.tool_name}: ${String(r.result_value??'').slice(0,300)}]`);\n  if(t.message) lines.push(`${t.role==='agent'?'Mira':'Anrufer'}: ${t.message}`);\n}\nconst transcript=lines.join('\\n');\nlet price=0;\nfor(const u of Object.values(m.charging?.llm_usage?.irreversible_generation?.model_usage??{})) for(const part of Object.values(u)) price+=Number(part?.price??0);\nreturn {json:{call_id:c.conversation_id,started_at:m.start_time_unix_secs?new Date(m.start_time_unix_secs*1000).toISOString():null,\n  duration_seconds:m.call_duration_secs??0,credits:Number.isFinite(m.cost)?m.cost:null,cost_cents:Math.round(price*100),\n  transcript,prompt:transcript.slice(0,30000)||'(leeres Gespräch)'}};"
      },
      "id": "32ed9ea0-5a1e-5d12-a3a3-af59e524bbab",
      "name": "Transkript aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {
          "codeInterpreter": false
        },
        "options": {
          "instructions": "Du wertest ein beendetes Gespräch des KI-Telefonassistenten Mira der RheinWerk Industrieservice GmbH aus\n(Kompressoren, Pumpen, industrielle Lüftung; Region Rhein-Neckar). Antworte nur mit dem JSON-Schema.\n- kategorie: Hauptanliegen. neue_anfrage = neue Service-Anfrage aufgenommen oder gewünscht; termin = Terminfrage zu\n  bestehender Anfrage; status = Stand einer Anfrage; verspaetung = Techniker kommt zu spät; frage = allgemeine Frage\n  (Leistungen, Preise, Zeiten); notfall = Gefahr für Personen oder Stillstand mit sofortigem Handlungsbedarf;\n  beschwerde; ausserhalb_gebiet = Standort außerhalb des Einsatzgebiets; spam = Werbung, kein Anliegen;\n  sonstiges = alles andere, auch abgebrochene Gespräche.\n- dringlichkeit: wie der Anrufer es schildert; ohne Angabe planbar. production_stop nur bei stehender Produktion.\n- sicherheitsgefahr: known nur bei genannter Gefahr (Brand, Gas, austretende Stoffe, Verletzte), unclear bei\n  Unsicherheit, sonst none_known.\n- firma, kontakt, rueckrufnummer, anfrage_nummer: nur wenn im Gespräch genannt oder bestätigt, sonst null.\n  anfrage_nummer im Format RIS-JJJJ-NNNNN, z. B. aus der Antwort eines Werkzeugs.\n- zusammenfassung: 1–2 sachliche deutsche Sätze für den Service Desk (was wollte der Anrufer, was ist passiert,\n  was bleibt offen). Keine E-Mail-Adressen.\n- rueckruf_noetig: true, wenn ein Mensch zurückrufen muss (ausdrücklicher Wunsch, Werkzeugstörung, Beschwerde,\n  Anliegen offen geblieben). false, wenn eine Anfrage angelegt wurde und der Service Desk sie wie üblich bearbeitet.\n- stimmung: Stimmung des Anrufers am Ende.",
          "maxTokens": 800,
          "temperature": 0.1,
          "store": false,
          "serviceTier": "default",
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "rheinwerk_call",
              "schema": "{\"type\": \"object\", \"properties\": {\"kategorie\": {\"type\": \"string\", \"enum\": [\"neue_anfrage\", \"termin\", \"status\", \"verspaetung\", \"frage\", \"notfall\", \"beschwerde\", \"ausserhalb_gebiet\", \"spam\", \"sonstiges\"]}, \"dringlichkeit\": {\"type\": \"string\", \"enum\": [\"planbar\", \"zeitnah\", \"erheblich\", \"production_stop\"]}, \"sicherheitsgefahr\": {\"type\": \"string\", \"enum\": [\"none_known\", \"known\", \"unclear\"]}, \"firma\": {\"type\": [\"string\", \"null\"]}, \"kontakt\": {\"type\": [\"string\", \"null\"]}, \"rueckrufnummer\": {\"type\": [\"string\", \"null\"]}, \"anfrage_nummer\": {\"type\": [\"string\", \"null\"]}, \"zusammenfassung\": {\"type\": \"string\"}, \"rueckruf_noetig\": {\"type\": \"boolean\"}, \"stimmung\": {\"type\": \"string\", \"enum\": [\"positiv\", \"neutral\", \"negativ\"]}}, \"required\": [\"kategorie\", \"dringlichkeit\", \"sicherheitsgefahr\", \"firma\", \"kontakt\", \"rueckrufnummer\", \"anfrage_nummer\", \"zusammenfassung\", \"rueckruf_noetig\", \"stimmung\"], \"additionalProperties\": false}",
              "strict": true
            }
          }
        }
      },
      "id": "a2f23f11-dad0-58be-994d-8dec062c662a",
      "name": "Auswerten (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "qK86QY5Bm6EfR9Zz",
          "name": "OpenAI account 3"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw=$json;const parts=Array.isArray(raw.output)?raw.output.flatMap(o=>o.content??[]):Array.isArray(raw.content)?raw.content:[];\nconst resultParts=parts.filter(p=>p.type==='output_text');\nconst responseObject=resultParts.find(p=>p.text&&typeof p.text==='object')?.text;\nconst responseText=resultParts.filter(p=>typeof p.text==='string').map(p=>p.text).join('');\nconst text=responseObject??(responseText||raw.output_text||raw.choices?.[0]?.message?.content||raw.content?.parts?.map(x=>x.text??'').join('')||raw.text||(typeof raw.output==='string'?raw.output:'')||'');\nlet analysis=null;try{analysis=typeof text==='object'?text:JSON.parse(String(text).replace(/^```(?:json)?\\s*/,'').replace(/\\s*```$/,''));}catch{analysis=null;}\n// Without a valid evaluation nothing is stored: the conversation stays pending for the next run\nif(!analysis||!analysis.kategorie) return null;\nconst call=$('Transkript aufbereiten').item.json;\nreturn {json:{call_id:call.call_id,started_at:call.started_at,duration_seconds:call.duration_seconds,transcript:call.transcript,analysis,credits:call.credits,cost_cents:call.cost_cents}};"
      },
