 \"machine_number\": {\"type\": [\"string\", \"null\"]}, \"equipment_type\": {\"type\": [\"string\", \"null\"], \"enum\": [\"compressor\", \"pump\", \"ventilation\", null]}, \"fault_description\": {\"type\": [\"string\", \"null\"]}, \"fault_codes\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"safety_indicators\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"contradictions\": {\"type\": \"boolean\"}, \"components\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"manufacturer\": {\"type\": [\"string\", \"null\"]}, \"model\": {\"type\": [\"string\", \"null\"]}, \"description\": {\"type\": [\"string\", \"null\"]}}, \"required\": [\"manufacturer\", \"model\", \"description\"], \"additionalProperties\": false}}, \"readable\": {\"type\": \"boolean\"}}, \"required\": [\"manufacturer\", \"model\", \"machine_number\", \"equipment_type\", \"fault_description\", \"fault_codes\", \"safety_indicators\", \"contradictions\", \"components\", \"readable\"], \"additionalProperties\": false}","strict":true}}}},"credentials":{"openAiApi":{"id":"qK86QY5Bm6EfR9Zz","name":"OpenAI account 3"}},"onError":"continueRegularOutput"},"output":[{"json":{}}]});
const extract = node({"type":"n8n-nodes-base.code","version":2,"config":{"name":"Extraktion normalisieren","parameters":{"mode":"runOnceForAllItems","jsCode":"const raw=$input.first().json;const parts=Array.isArray(raw.output)?raw.output.flatMap(o=>o.content??[]):Array.isArray(raw.content)?raw.content:[];\nconst resultParts=parts.filter(p=>p.type==='output_text');\nconst responseObject=resultParts.find(p=>p.text&&typeof p.text==='object')?.text;\nconst responseText=resultParts.filter(p=>typeof p.text==='string').map(p=>p.text).join('');\nconst text=responseObject??(responseText||raw.output_text||raw.choices?.[0]?.message?.content||raw.content?.parts?.map(x=>x.text??'').join('')||raw.text||(typeof raw.output==='string'?raw.output:'')||'');\nlet extracted;try{extracted=typeof text==='object'?text:JSON.parse(String(text).replace(/^```(?:json)?\\s*/,'').replace(/\\s*```$/,''));}catch{extracted={readable:false,error:'Extraktion fehlgeschlagen'};}\nreturn [{json:{attachment:$('Aufruf aus Hauptworkflow').first().json,extracted}}];"}},"output":[{"json":{"extracted":{"readable":true}}}]});
export default workflow("rheinwerk-attachment-analysis","RheinWerk · Anhänge analysieren").add(start).to(download).to(verify).to(pdf.onTrue(doc.to(extract)).onFalse(img.to(extract)));
