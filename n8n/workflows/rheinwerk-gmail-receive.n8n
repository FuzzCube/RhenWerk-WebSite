export default workflow("rheinwerk-gmail-receive","RheinWerk · Gmail Eingang").add(start).to(mailloop.onEachBatch(profile.to(mailbox).to(normalize).to(record).to(valid.onTrue(files).onFalse(nextBatch(mailloop))))).add(files).to(fileloop.onEachBatch(hasfile.onTrue(verify).onFalse(nextBatch(fileloop))).onDone(finish)).add(verify).to(fileok.onTrue(upload.to(uploadcheck).to(register).to(registered).to(nextBatch(fileloop))).onFalse(nextBatch(fileloop))).add(finish).to(complete).to(nextBatch(mailloop)).add(recovery).to(recoveryprofile).to(recoveryguard).to(pending).to(reload).to(mailloop).add(sweep).to(sweepprofile).to(sweepguard).to(sweepmail).to(mailloop);
