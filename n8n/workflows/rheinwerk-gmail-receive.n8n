const complete = node({"type":"n8n-nodes-base.httpRequest","version":4.5,"config":{"name":"Antwort für Analyse freigeben","parameters":{"method":"POST","url":"http://host.docker.internal:54321/rest/v1/rpc/complete_incoming_message","authentication":"predefinedCredentialType","nodeCredentialType":"supabaseApi","sendBody":true,"specifyBody":"json","jsonBody":expr("{{ $json }}"),"options":{"timeout":20000,"response":{"response":{"responseFormat":"json","neverError":false}}}},"credentials":{"supabaseApi":{"id":"rwdda8aefff1e947","name":"RheinWerk Supabase Lokal"}}},"output":[{"json":{}}]});
