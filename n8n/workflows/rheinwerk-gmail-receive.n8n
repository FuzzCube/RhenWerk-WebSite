const start = trigger({"type":"n8n-nodes-base.gmailTrigger","version":1.4,"config":{"name":"Neue Gmail-Antwort","parameters":{"authentication":"oAuth2","pollTimes":{"item":[{"mode":"everyMinute"}]},"event":"messageReceived","simple":false,"maxResults":5,"filters":{"q":"in:inbox -from:rheinwerk.industrieservice@gmail.com","readStatus":"both","includeSpamTrash":false,"includeDrafts":false},"options":{"downloadAttachments":true,"dataPropertyAttachmentsPrefixName":"attachment_"}},"credentials":{"gmailOAuth2":{"id":"rw46346a76655347","name":"RheinWerk Gmail"}}},"output":[{"json":{"id":"gmail-example","threadId":"thread-example","text":"Antwort","from":{"value":[{"address":"customer@example.com"}]}}}]});
