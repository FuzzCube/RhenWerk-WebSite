      "parameters": {
        "jsCode": "const raw=$input.first().json;const parts=Array.isArray(raw.output)?raw.output.flatMap(o=>o.content??[]):Array.isArray(raw.content)?raw.content:[];\nconst resultParts=parts.filter(p=>p.type==='output_text');\nconst responseObject=resultParts.find(p=>p.text&&typeof p.text==='object')?.text;\nconst responseText=resultParts.filter(p=>typeof p.text==='string').map(p=>p.text).join('');\nconst text=responseObject??(responseText||raw.output_text||raw.choices?.[0]?.message?.content||raw.content?.parts?.map(x=>x.text??'').join('')||raw.text||(typeof raw.output==='string'?raw.output:'')||'');\nlet extracted;try{extracted=typeof text==='object'?text:JSON.parse(String(text).replace(/^```(?:json)?\\s*/,'').replace(/\\s*```$/,''));}catch{extracted={readable:false,error:'Extraktion fehlgeschlagen'};}\nreturn [{json:{attachment:$('Aufruf aus Hauptworkflow').first().json,extracted}}];"
      },
