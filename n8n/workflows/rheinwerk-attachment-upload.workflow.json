      "name": "Dateiinhalt prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item=$input.first();const b=await this.helpers.getBinaryDataBuffer(0,'data');\nconst meta=$('Aufruf aus Hauptworkflow').first().json;\nif(b.length<1||b.length>5242880)throw new Error('Ungültige Dateigröße');\nconst t=meta.mime_type??meta.attachment?.mime_type;\nconst magic=t==='application/pdf'?b.subarray(0,5).toString()==='%PDF-':t==='image/png'?b.subarray(0,8).toString('hex')==='89504e470d0a1a0a':t==='image/jpeg'?b[0]===255&&b[1]===216:false;\nif(!magic)throw new Error('Dateityp stimmt nicht mit dem Inhalt überein');\nreturn [{json:{...meta,verified_size:b.length},binary:item.binary}];"
      }
    },
    {
