          "id": "rwdda8aefff1e947",
          "name": "RheinWerk Supabase Lokal"
        }
      }
    },
    "output": [
      {
        "json": {
          "id": "message-example",
          "request_id": "request-example",
          "ignored": false
        }
      }
    ]
  },
  {
    "key": "valid",
    "kind": "ifElse",
    "type": "n8n-nodes-base.if",
    "version": 2.3,
    "config": {
      "name": "Verarbeitbare Nachricht?",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "@@{{ $json.ignored !== true && !!$json.id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    "output": [
      {
        "json": {}
      }
    ]
  },
  {
    "key": "files",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Gmail-Anhänge vorbereiten",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const message=$input.first().json;const original=$('Gmail-Antwort normalisieren').item;const all=Object.entries(original.binary??{});const warnings=[];const files=[];\nfor(const [i,[key,b]] of all.entries()){if(i>=3){warnings.push('Mehr als drei E-Mail-Anhänge');continue;}if(!['application/pdf','image/jpeg','image/png'].includes(b.mimeType)){warnings.push('Nicht unterstützter Anhang: '+(b.fileName??key));continue;}\nconst name=String(b.fileName??key).replace(/[^a-zA-Z0-9._-]/g,'_').slice(0,140);files.push({json:{message_id:message.id,request_id:message.request_id,mime_type:b.mimeType,file_name:b.fileName??key,storage_path:'messages/'+message.id+'/'+i+'_'+name,skip_file:false,warnings},binary:{data:b}});}\nif(!files.length)return [{json:{message_id:message.id,request_id:message.request_id,skip_file:true,warnings}}];return files;"
      }
    },
    "output": [
      {
        "json": {
          "message_id": "message-example",
          "storage_path": "messages/example/photo.png",
          "mime_type": "image/png",
          "skip_file": false,
          "warnings": []
        }
      }
    ]
  },
