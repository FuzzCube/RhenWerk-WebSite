    "key": "hasfile",
    "kind": "ifElse",
    "type": "n8n-nodes-base.if",
    "version": 2.3,
    "config": {
      "name": "Gmail-Anhang vorhanden?",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "@@{{ $json.skip_file !== true }}",
              "rightValue": true,
              "operator": {
