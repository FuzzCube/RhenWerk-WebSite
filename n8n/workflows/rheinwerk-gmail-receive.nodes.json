  {
    "key": "mailbox",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Empfangspostfach bestätigen",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const mailbox=String(r.body?.emailAddress??r.emailAddress??'').toLowerCase();if(mailbox!=='rheinwerk.industrieservice@gmail.com')throw new Error('RheinWerk Gmail-Konto nicht bestätigt');return [{json:{mailbox_verified:true}}];"
      }
    },
    "output": [
      {
        "json": {
          "mailbox_verified": true
        }
      }
    ]
  },
  {
    "key": "normalize",
    "kind": "node",
    "type": "n8n-nodes-base.code",
    "version": 2,
    "config": {
      "name": "Gmail-Antwort normalisieren",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item=$('Eingehende E-Mails einzeln').item;const m=item.json;const h=m.headers??{};\nconst header=n=>{let v=Array.isArray(h)?h.find(x=>String(x.name).toLowerCase()===n)?.value:h[n]??h[n.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())];return typeof v==='string'?v:v?.text??'';};\nconst from=m.from?.value?.[0]?.address??m.from?.address??header('from')??'';const address=String(from).match(/<([^<>]+)>/)?.[1]??String(from).trim();\nconst references=m.references??header('references');const refs=Array.isArray(references)?references:String(references??'').match(/<[^<>\\s]+>/g)??[];\nif(!m.id||!address)throw new Error('Gmail-Nachrichtenidentität fehlt');\nlet text=m.text??m.bodyText??'';if(!text&&m.html)text=String(m.html).replace(/<[^>]*>/g,' ').replace(/\\s+/g,' ').trim();\nconst p={contract_version:'1.0',mailbox_key:'rheinwerk.industrieservice@gmail.com',gmail_message_id:m.id,gmail_thread_id:m.threadId,mime_message_id:m.messageId??header('message-id')??null,in_reply_to:m.inReplyTo??header('in-reply-to')??null,references_header:refs,from_address:address,subject:m.subject??header('subject')??'',body_text:String(text),received_at:m.date?new Date(m.date).toISOString():new Date().toISOString()};\nreturn [{json:{payload:p},binary:item.binary}];"
      }
    },
    "output": [
      {
        "json": {
          "payload": {
            "contract_version": "1.0"
          }
        }
      }
    ]
  },
  {
    "key": "record",
    "kind": "node",
    "type": "n8n-nodes-base.httpRequest",
    "version": 4.5,
