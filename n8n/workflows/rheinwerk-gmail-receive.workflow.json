    {
      "parameters": {
        "jsCode": "const item=$input.first();const b=await this.helpers.getBinaryDataBuffer(0,'data');const m=item.json;const t=m.mime_type;\nconst magic=t==='application/pdf'?b.subarray(0,5).toString()==='%PDF-':t==='image/png'?b.subarray(0,8).toString('hex')==='89504e470d0a1a0a':t==='image/jpeg'?b[0]===255&&b[1]===216:false;\nif(b.length<1||b.length>5242880||!magic)return [{json:{...m,skip_file:true,warnings:[...m.warnings,'Dateityp oder Größe ungültig: '+m.file_name]}}];\nreturn [{json:{...m,size_bytes:b.length},binary:item.binary}];"
