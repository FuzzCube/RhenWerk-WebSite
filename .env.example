# Set after the local n8n pipeline has passed Gmail and analysis checks.
N8N_WEBHOOK_URL=

MAKE_WEBHOOK_URL=
MAKE_API_KEY=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase (lokal: Werte aus `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ versehen
SUPABASE_SECRET_KEY=

# Demo-Nutzer (npm run demo:users); nur lokal setzen, mindestens 12 Zeichen
DEMO_USER_PASSWORD=
# Nur für Demo-Bootstrap gegen ein Remote-Projekt auf 1 setzen
DEMO_BOOTSTRAP_ALLOW_REMOTE=

# Telefonassistent (task-13-5): Geheimnis der Agenten-Webhooks (n8n/bootstrap_agent_secret.py), ElevenLabs, Cloudflare Access Service Token
AGENT_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Web-Widget „Mit Mira sprechen“ (task-13-8), optional: anderer Agent als in docs/telefonassistent/elevenlabs.json,
# Salz für den Hash der IP-Adresse (Standard: SUPABASE_SECRET_KEY)
ELEVENLABS_AGENT_ID=
MIRA_WIDGET_SALT=

# Wächter (task-17-9): Warnung, wenn das ElevenLabs-Guthaben unter diese Zahl Credits fällt (Standard 10 % des
# Monatskontingents). Der Schlüssel braucht dafür die Berechtigung „User: Read“.
MIRA_CREDIT_MIN=

# Wächter (task-17-8): Schlüssel der n8n-API (n8n → Settings → n8n API, ohne Ablauf) für aktive Workflows, Zeitpläne
# und den Error-Workflow (n8n/assign_error_workflow.mjs). Optional: N8N_API_URL (Standard http://127.0.0.1:5678)
N8N_API_KEY=

# Sicherung (npm run backup, docs/betrieb.md): Passphrase verschlüsselt das Archiv und nimmt n8n-Schlüssel und
# .env.local mit auf; zusätzlich im Passwort-Manager ablegen. Optional: BACKUP_DIR, BACKUP_KEEP_DAYS, N8N_CONTAINER
BACKUP_PASSPHRASE=

# Warn-E-Mails an den Betreiber (task-17-3), unabhängig von n8n: Gmail SMTP mit App-Passwort
# (myaccount.google.com/apppasswords, Zwei-Faktor nötig). ALERT_EMAILS kommagetrennt; nicht ins Repository.
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAILS=

# Token für die Einzelergebnisse von /api/health (task-17-4): openssl rand -hex 32
HEALTH_TOKEN=
